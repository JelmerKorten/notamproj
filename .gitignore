# ============================================================
# NotamPlotter .gitignore
# Principle: commit source, tests, docs, config templates and CI;
# ignore secrets, local state, and anything the build regenerates.
# ============================================================

# --- macOS ---
.DS_Store

# --- Python / environments ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# --- Local build artifacts ---
build/
dist/

# --- Tooling caches & logs ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.log

# --- Secrets ---
# Never commit .env or any local env variant. .env.example is a
# committed template and must stay tracked.
.env
.env.*
!.env.example

# --- Private plot overlay (location-specific routes/grid) ---
# Copy plot_overlay.example.json to plot_overlay.json and fill in.
plot_overlay.json

# --- Regenerated data / plot output ---
tests/
files/
output/