# Copy this file to `.env` and fill in local values. `.env` is git-ignored.
# Environment variables always override config.yaml.

# === App Config ===
NOTAM_AIRPORTS=OMAE,OMAA,OMAD,OMAM,OMDB,OMDW,OMSJ,OMAL,OMFJ,OMRK,OMDM,OMBY,OMDL
NOTAM_OUTPUT_DIR=./output
NOTAM_FILES_DIR=./files
NOTAM_CLEANUP_DAYS=5
NOTAM_LOG_LEVEL=INFO

# === FAA API (no keys needed, but configurable) ===
FAA_API_BASE_URL=https://notams.aim.faa.gov/notamSearch

# === Email (SMTP) — used by Phase 4 ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=app-password-here   # Never commit this
EMAIL_FROM=your@email.com
EMAIL_TO=recipient@email.com