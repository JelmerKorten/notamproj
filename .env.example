# Copy this file to `.env` and fill in local values. `.env` is git-ignored.
# Environment variables always override config.yaml.

# === App Config ===
# Override via env vars.
NOTAM_AIRPORTS=EHAM,NZSP,VHHH,SEQM
NOTAM_OUTPUT_DIR=./output
NOTAM_FILES_DIR=./files
NOTAM_LOG_LEVEL=INFO

# === FAA API (no keys needed, but configurable) ===
FAA_API_BASE_URL=https://notams.aim.faa.gov/notamSearch

# === Email (SMTP) — used by Phase 4 ===
# Classic LOGIN auth (other relays, or Gmail when an app password exists):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=app-password-here   # Never commit this; leave empty when using OAuth below
EMAIL_FROM=from@example.com
EMAIL_TO=to@example.com

# === Email (Gmail OAuth2 / XOAUTH2) — preferred for Gmail ===
# Obtain client id/secret via Google Cloud Console (OAuth client ID, Desktop app).
# Then run `notamplotter auth` once to print GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=   # from the `notamplotter auth` bootstrap; never commit